# Copy to deploy/.env on the server. Never commit the filled file.
# Generate independent hex values with: openssl rand -hex 32
# Hex avoids URL-encoding issues in the PostgreSQL connection string.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
JWT_SECRET=REPLACE_WITH_SEPARATE_GENERATED_HEX_SECRET
JWT_EXPIRES_IN=8h
# Your actual Netlify origin: HTTPS, no trailing slash.
CLIENT_URL=https://YOUR-SITE.netlify.app
# DNS hostname only: no protocol or path. Its A record must point at your server.
API_DOMAIN=api.YOUR-DOMAIN.com
OLLAMA_TIMEOUT_MS=60000
DOCUMENT_SUMMARY_BATCH_CHARS=8000
