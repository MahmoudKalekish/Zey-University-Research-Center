    }
    Publication {
        String id PK
        String title
        String slug UK
        String abstract
        DateTime publicationDate
        String doi UK "nullable"
        String venue
        String_array keywords "list; SQL column nullable"
        PublicationType type
        String pdfUrl "nullable"
        String externalUrl "nullable"
