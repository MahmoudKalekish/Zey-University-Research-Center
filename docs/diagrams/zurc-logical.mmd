erDiagram
    User {
        String id PK
        String email UK
        String passwordHash
        String firstName
        String lastName
        Role role
        Boolean active
        DateTime createdAt
        DateTime updatedAt
    }
    Researcher {
        String id PK
        String userId FK,UK "nullable"
        String name
        String slug UK
        String biography
        String position
        String email UK
        String photoUrl "nullable"
        String affiliation
        String orcid UK "nullable"
        String linkedInUrl "nullable"
        String scholarUrl "nullable"
        String_array interests "list; SQL column nullable"
        Boolean active
        DateTime createdAt
        DateTime updatedAt
    }
    ResearchArea {
        String id PK
        String name UK
        String slug UK
        String description
        String icon
        String imageUrl "nullable"
        String_array objectives "list; SQL column nullable"
        DateTime createdAt
        DateTime updatedAt
    }
    ResearcherArea {
        String researcherId PK,FK
        String areaId PK,FK
    }
    Project {
        String id PK
        String title
        String slug UK
        String description
        String abstract
        String_array objectives "list; SQL column nullable"
        DateTime startDate
        DateTime endDate "nullable"
        ProjectStatus status
        String funding "nullable"
        Boolean featured
        DateTime createdAt
        DateTime updatedAt
    }
    ProjectArea {
        String projectId PK,FK
        String areaId PK,FK
    }
    ProjectResearcher {
        String projectId PK,FK
        String researcherId PK,FK
